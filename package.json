{
  "name": "freya-travel",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "entries:sync": "node scripts/app-entries.mjs --write",
    "entries:check": "node scripts/app-entries.mjs",
    "test:entries": "node --test scripts/app-entries.test.mjs",
    "test:home": "node --test scripts/trip-home.test.mjs",
    "test:progress": "node --test scripts/trip-progress.test.mjs",
    "test": "node --test scripts/*.test.mjs",
    "test:db": "node scripts/test-progress-db.mjs",
    "test:proposals:browser": "node scripts/check-proposals-browser.mjs",
    "predev": "npm run entries:sync",
    "dev": "vite",
    "prebuild": "npm run entries:sync && node scripts/browser-runtime.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "postbuild": "node scripts/package-pages.mjs",
    "test:alb03": "node --test scripts/alb03-ingestion.test.mjs",
    "test:alb03:db": "node scripts/test-travel-book-ingestion-db.mjs",
    "test:alb03:image": "deno test --config supabase/functions/travel-book-ingest/deno.json --allow-read --allow-write supabase/functions/travel-book-ingest/image.test.ts",
    "check:alb03": "npm run test:alb03 && npm run test:alb03:image && npm run test:alb03:db && npm run entries:check",
    "test:alb02": "node --test scripts/travel-book-*.test.mjs",
    "test:alb02:db": "node scripts/test-travel-book-db.mjs",
    "check:alb02": "npm run test:alb02 && npm run test:alb02:db && npm run entries:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.7.2",
    "vite": "^6.1.0"
  }
}
